# ─────────────────────────────────────────────────────────────────────────────
# Traveler AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini AI (Required) ──────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=AIzaSyAQ.Ab8RN6KRsPGJ16FOI-RzodBleZlQDdjyXZ-05IakjIioemZrJw

# ── Anthropic Claude (Optional — add key to enable Claude model) ───────────────
# HOW TO GET:
#  1. Visit https://console.anthropic.com → sign up
#  2. Go to API Keys → Create key
#  3. Pricing: ~$3/M input tokens, $15/M output tokens (claude-3-5-sonnet)
#  4. Free trial credits available on sign-up
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── OpenWeatherMap (Optional — enables live weather in trip plans) ─────────────
# HOW TO GET:
#  1. Visit https://openweathermap.org → Sign up free
#  2. Go to My Profile → API Keys → copy Default key
#  3. Free tier: 60 calls/min, 1,000,000 calls/month — more than enough
#  4. Key activates within 10 minutes of account creation
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# ── Stripe Payments (Required for credit purchases) ───────────────────────────
# HOW TO GET:
#  1. Visit https://dashboard.stripe.com → create free account
#  2. Developers → API Keys → Secret key (sk_test_... for testing)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# ── Stripe Webhook (for confirming payments server-side) ──────────────────────
# HOW TO GET (local dev):
#  1. Install Stripe CLI from https://stripe.com/docs/stripe-cli
#  2. Run: stripe login
#  3. Run: stripe listen --forward-to localhost:8000/api/stripe_webhook
#  4. Copy the whsec_... secret shown
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── Frontend URL (used for Stripe payment redirects) ──────────────────────────
FRONTEND_URL=http://localhost:5173,http://localhost:4173


# -- Google Auth --------------------------------------------------------------
GOOGLE_CLIENT_ID=627632712302-7oes264tnnvfue7n2klf5od67ukefi75.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
